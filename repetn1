
Algoritmo Maximo_Comun_Divisor
    Definir num1, num2, residuo Como Entero

    Escribir "Ingrese el primer numero entero positivo:"
    Leer num1
    Mientras num1 <= 0 Hacer
        Escribir "Error: ingrese un numero mayor que cero:"
        Leer num1
    FinMientras

    Escribir "Ingrese el segundo numero entero positivo:"
    Leer num2
    Mientras num2 <= 0 Hacer
        Escribir "Error: ingrese un numero mayor que cero:"
        Leer num2
    FinMientras

    Mientras num2 <> 0 Hacer
        residuo = num1 MOD num2
        num1 = num2
        num2 = residuo
    FinMientras

    Escribir "El maximo comun divisor es: ", num1
FinAlgoritmo
